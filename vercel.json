{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/web/index" },
    { "source": "/index", "destination": "/web/index" },
    { "source": "/index.html", "destination": "/web/index" },
    { "source": "/result", "destination": "/web/result" },
    { "source": "/result.html", "destination": "/web/result" },
    { "source": "/share", "destination": "/web/share" },
    { "source": "/share.html", "destination": "/web/share" },
    { "source": "/share/:id", "destination": "/web/share" },
    { "source": "/poster", "destination": "/web/poster" },
    { "source": "/poster.html", "destination": "/web/poster" },
    { "source": "/privacy", "destination": "/web/privacy" },
    { "source": "/privacy.html", "destination": "/web/privacy" },
    { "source": "/assets/:path*", "destination": "/web/assets/:path*" },
    { "source": "/api/:fn", "destination": "https://ddlt-d7gvi23us2cc67847.service.tcloudbase.com/:fn" }
  ]
}
